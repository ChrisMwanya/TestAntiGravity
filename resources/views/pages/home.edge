<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      FinanceApp - Master Your Money
    </title>
    <script src="https://cdn.tailwindcss.com">

    </script>
    <script src="//unpkg.com/alpinejs" defer>

    </script>
    @vite(['resources/js/app.js'])
  </head>
  <body class="bg-slate-900 text-white font-sans antialiased">

    <!-- Navigation -->
    <nav class="absolute top-0 w-full z-50">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          <div class="flex-shrink-0">
            <a
              href="/"
              class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
            >
              FinanceApp
          </a>
          </div>
          <div class="hidden md:block">
            <div class="ml-10 flex items-baseline space-x-4">
              <a
                href="/login"
                class="text-gray-300 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition"
              >Sign In</a>
              <a
                href="/register"
                class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg text-sm font-medium transition backdrop-blur-sm border border-white/10"
              >Get Started</a>
            </div>
          </div>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <div class="relative overflow-hidden min-h-screen flex items-center">
      <!-- Background Effects -->
      <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10">
        <div
          class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-purple-600/20 rounded-full blur-[120px]"
        >
        </div>
        <div
          class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-pink-600/20 rounded-full blur-[120px]"
        >
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20">
        <div class="text-center max-w-3xl mx-auto">
          <h1 class="text-5xl md:text-7xl font-bold tracking-tight mb-8">
            Master Your Money <br />
            <span class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Build Your Future</span>
          </h1>
          <p class="text-xl text-gray-400 mb-10 leading-relaxed">
            Take control of your finances with our powerful, intuitive platform. Track expenses, set budgets, and watch your wealth grow—all in one place.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4">
            <a
              href="/register"
              class="px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl text-lg font-bold hover:from-purple-600 hover:to-pink-600 transition shadow-lg shadow-purple-500/25"
            >
              Start for Free
          </a>
            <a
              href="/login"
              class="px-8 py-4 bg-white/5 border border-white/10 rounded-xl text-lg font-bold hover:bg-white/10 transition backdrop-blur-md"
            >
              Sign In
          </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <div class="py-24 bg-slate-900/50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-3xl md:text-4xl font-bold mb-4">
            Everything you need to succeed
          </h2>
          <p class="text-gray-400">
            Powerful features to help you manage your financial life.
          </p>
        </div>

        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Feature 1 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Smart Tracking
            </h3>
            <p class="text-gray-400 text-sm">
              Monitor every penny with our intuitive transaction tracking system.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-pink-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Budgeting
            </h3>
            <p class="text-gray-400 text-sm">
              Set monthly limits and stick to them with real-time alerts.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Insights
            </h3>
            <p class="text-gray-400 text-sm">
              Visualize your spending habits with beautiful charts and graphs.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Customizable
            </h3>
            <p class="text-gray-400 text-sm">
              Create your own categories and account types to fit your lifestyle.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-white/10 py-12 bg-slate-900">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center"
      >
        <div class="mb-4 md:mb-0">
          <span
            class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
          >
            FinanceApp
        </span>
          <p class="text-gray-500 text-sm mt-2">
            © 2024 FinanceApp. All rights reserved.
          </p>
        </div>
        <div class="flex space-x-6 text-gray-400">
          <a href="#" class="hover:text-white transition">Privacy</a>
          <a href="#" class="hover:text-white transition">Terms</a>
          <a href="#" class="hover:text-white transition">Contact</a>
        </div>
      </div>
    </footer>

  </body>
</html>
