<!DOCTYPE html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>
      FinanceApp - Maîtrisez Votre Argent
    </title>
    <script src="https://cdn.tailwindcss.com">

    </script>
    <script src="//unpkg.com/alpinejs" defer>

    </script>
    @vite(['resources/js/app.js'])
  </head>
  <body class="bg-slate-900 text-white font-sans antialiased">

    <!-- Navigation -->
    <nav class="absolute top-0 w-full z-50" x-data="{ mobileOpen: false }">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="flex justify-between items-center h-20">
          <div class="flex-shrink-0">
            <a
              href="/"
              class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
            >
              FinanceApp
          </a>
          </div>
          <!-- Desktop Links -->
          <div class="hidden md:block">
            <div class="ml-10 flex items-baseline space-x-4">
              <a
                href="/login"
                class="text-gray-300 hover:text-white px-3 py-2 rounded-md text-sm font-medium transition"
              >Se connecter</a>
              <a
                href="/register"
                class="bg-white/10 hover:bg-white/20 text-white px-4 py-2 rounded-lg text-sm font-medium transition backdrop-blur-sm border border-white/10"
              >Commencer</a>
            </div>
          </div>
          <!-- Mobile Hamburger -->
          <button
            @click="mobileOpen = !mobileOpen"
            class="md:hidden flex items-center justify-center w-10 h-10 rounded-lg hover:bg-white/10 transition"
            aria-label="Toggle menu"
          >
            <svg x-show="!mobileOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            <svg x-show="mobileOpen" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24" style="display:none;">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
            </svg>
          </button>
        </div>
      </div>

      <!-- Mobile Menu -->
      <div
        x-show="mobileOpen"
        x-transition:enter="transition ease-out duration-200"
        x-transition:enter-start="opacity-0 -translate-y-2"
        x-transition:enter-end="opacity-100 translate-y-0"
        x-transition:leave="transition ease-in duration-150"
        x-transition:leave-start="opacity-100 translate-y-0"
        x-transition:leave-end="opacity-0 -translate-y-2"
        class="md:hidden bg-slate-900/95 backdrop-blur-md border-t border-white/10"
        style="display: none;"
      >
        <div class="px-4 py-4 flex flex-col space-y-3">
          <a href="/login" class="block px-4 py-2 rounded-lg hover:bg-white/10 transition text-gray-300 font-medium">Se connecter</a>
          <a href="/register" class="block px-4 py-2 rounded-lg bg-white/10 hover:bg-white/20 transition font-medium border border-white/10">Commencer</a>
        </div>
      </div>
    </nav>

    <!-- Hero Section -->
    <div class="relative overflow-hidden min-h-screen flex items-center">
      <!-- Background Effects -->
      <div class="absolute top-0 left-0 w-full h-full overflow-hidden -z-10">
        <div
          class="absolute top-[-10%] left-[-10%] w-[40%] h-[40%] bg-purple-600/20 rounded-full blur-[120px]"
        >
        </div>
        <div
          class="absolute bottom-[-10%] right-[-10%] w-[40%] h-[40%] bg-pink-600/20 rounded-full blur-[120px]"
        >
        </div>
      </div>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 w-full pt-20">
        <div class="text-center max-w-3xl mx-auto">
          <h1 class="text-4xl sm:text-5xl md:text-7xl font-bold tracking-tight mb-8">
            Maîtrisez Votre Argent <br />
            <span class="bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">Construisez Votre Avenir</span>
          </h1>
          <p class="text-lg sm:text-xl text-gray-400 mb-10 leading-relaxed px-4">
            Prenez le contrôle de vos finances avec notre plateforme puissante et intuitive. Suivez vos dépenses, définissez des budgets et faites croître votre patrimoine — le tout en un seul endroit.
          </p>
          <div class="flex flex-col sm:flex-row justify-center gap-4 px-4">
            <a
              href="/register"
              class="px-8 py-4 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl text-lg font-bold hover:from-purple-600 hover:to-pink-600 transition shadow-lg shadow-purple-500/25"
            >
              Commencer gratuitement
          </a>
            <a
              href="/login"
              class="px-8 py-4 bg-white/5 border border-white/10 rounded-xl text-lg font-bold hover:bg-white/10 transition backdrop-blur-md"
            >
              Se connecter
          </a>
          </div>
        </div>
      </div>
    </div>

    <!-- Features Section -->
    <div class="py-24 bg-slate-900/50 relative">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center mb-16">
          <h2 class="text-2xl sm:text-3xl md:text-4xl font-bold mb-4">
            Tout ce qu'il vous faut pour réussir
          </h2>
          <p class="text-gray-400">
            Des fonctionnalités puissantes pour gérer votre vie financière.
          </p>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
          <!-- Feature 1 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-purple-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Suivi intelligent
            </h3>
            <p class="text-gray-400 text-sm">
              Suivez chaque centime grâce à notre système de suivi des transactions intuitif.
            </p>
          </div>

          <!-- Feature 2 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-pink-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-pink-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"
                />
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Budgétisation
            </h3>
            <p class="text-gray-400 text-sm">
              Définissez des limites mensuelles et respectez-les grâce à des alertes en temps réel.
            </p>
          </div>

          <!-- Feature 3 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-blue-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-blue-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Analyses
            </h3>
            <p class="text-gray-400 text-sm">
              Visualisez vos habitudes de dépenses avec de beaux graphiques.
            </p>
          </div>

          <!-- Feature 4 -->
          <div class="p-6 rounded-2xl bg-white/5 border border-white/10 hover:bg-white/10 transition group">
            <div
              class="w-12 h-12 bg-green-500/20 rounded-xl flex items-center justify-center mb-4 group-hover:scale-110 transition"
            >
              <svg class="w-6 h-6 text-green-400" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  stroke-width="2"
                  d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"
                />
              </svg>
            </div>
            <h3 class="text-xl font-bold mb-2">
              Personnalisable
            </h3>
            <p class="text-gray-400 text-sm">
              Créez vos propres catégories et types de comptes adaptés à votre style de vie.
            </p>
          </div>
        </div>
      </div>
    </div>

    <!-- Footer -->
    <footer class="border-t border-white/10 py-12 bg-slate-900">
      <div
        class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 flex flex-col md:flex-row justify-between items-center gap-4"
      >
        <div class="text-center md:text-left">
          <span
            class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
          >
            FinanceApp
        </span>
          <p class="text-gray-500 text-sm mt-2">
            © 2024 FinanceApp. Tous droits réservés.
          </p>
        </div>
        <div class="flex space-x-6 text-gray-400">
          <a href="#" class="hover:text-white transition">Confidentialité</a>
          <a href="#" class="hover:text-white transition">Conditions</a>
          <a href="#" class="hover:text-white transition">Contact</a>
        </div>
      </div>
    </footer>

  </body>
</html>
