          <!-- Submit -->
          <div class="sm:col-span-2 lg:col-span-3">
            <button
              type="submit"
              class="w-full sm:w-auto px-8 py-3 bg-gradient-to-r from-orange-500 to-yellow-500 rounded-xl hover:from-orange-600 hover:to-yellow-600 transition font-semibold shadow-lg"
            >
              Add Fixed Charge
            </button>
          </div>
        </form>
      </div>

      <!-- Active Charges -->
      <div class="space-y-4">
        <h2 class="text-2xl font-bold">Active Charges</h2>

