                <!-- Dates -->
                <div class="pt-3 border-t border-white/10 space-y-1 text-sm">
                  <div class="flex justify-between">
                    <span class="text-gray-400">Prochain paiement</span>
                    <span class="font-medium text-orange-300">{{ charge.nextDueDate }}</span>
