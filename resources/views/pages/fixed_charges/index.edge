                <!-- Header -->
                <div class="flex justify-between items-start mb-3">
                  <div class="min-w-0 pr-2">
                    <h3 class="font-bold text-lg truncate">{{ charge.name }}</h3>
                    @if(charge.category)
                      <span class="text-xs text-gray-400">{{ charge.category.name }}</span>
                    @endif
                  </div>
                  <div class="flex items-center gap-1 shrink-0">
                    <!-- Toggle (pause) -->
                    <form action="/fixed-charges/{{ charge.id }}/toggle?_method=PATCH" method="POST">
                      {{ csrfField() }}
                      <button
                        type="submit"
                        title="Suspendre cette charge"
                        class="text-yellow-400 hover:text-yellow-300 transition p-1 hover:bg-yellow-500/10 rounded-lg"
                      >
                        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 9v6m4-6v6M21 12a9 9 0 11-18 0 9 9 0 0118 0z"/>
                        </svg>
                      </button>
                    </form>
                    <!-- Delete -->
                    <form action="/fixed-charges/{{ charge.id }}?_method=DELETE" method="POST">
                      {{ csrfField() }}
                      <button
                        type="submit"
                        onclick="return confirm('Supprimer cette charge fixe ?')"
                        class="text-red-400 hover:text-red-300 transition p-1 hover:bg-red-500/10 rounded-lg"
