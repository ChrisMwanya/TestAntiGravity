            >
              <option value="daily">📅 Daily</option>
              <option value="weekly">📅 Weekly</option>
              <option value="monthly" selected>📅 Monthly</option>
              <option value="quarterly">📅 Quarterly</option>
              <option value="yearly">📅 Yearly</option>
            </select>
          </div>

          <!-- Billing Day -->
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">
              Billing Day <span class="text-gray-500">(day of month, optional)</span>
            </label>
            <input
              type="number"
              name="billingDay"
              min="1"
              max="31"
              placeholder="e.g., 1, 15, 28"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition"
            />
