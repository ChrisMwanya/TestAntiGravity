                <div class="flex items-end justify-between mb-3">
                  <div>
                    <p class="text-3xl font-bold text-orange-400">${{ Number(charge.amount).toFixed(2) }}</p>
                    <span class="text-xs text-gray-400 capitalize">par {{ charge.frequency }}</span>
                  </div>
                  <span class="text-xs font-medium bg-orange-500/20 text-orange-300 px-2 py-1 rounded-full capitalize">
                    {{ charge.frequency }}
