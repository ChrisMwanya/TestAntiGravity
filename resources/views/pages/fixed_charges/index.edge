              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span x-text="showInactive ? 'Masquer' : 'Afficher'"></span> Charges suspendues ({{ inactiveCharges.length }})
          </button>

          <div x-show="showInactive" x-transition class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" style="display:none;">
            @each(charge in inactiveCharges)
