                    <div class="flex justify-between">
                      <span class="text-gray-400">Jour de facturation</span>
                      <span>{{ charge.billingDay }}</span>
                    </div>
                  @endif
                </div>
              </div>
            @endeach
          </div>
        @endif
      </div>

      <!-- Inactive Charges (collapsible) -->
      @if(inactiveCharges.length > 0)
        <div class="space-y-3">
          <button
