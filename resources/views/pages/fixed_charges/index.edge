            class="flex items-center gap-2 text-gray-400 hover:text-white transition text-sm font-medium"
          >
            <svg class="w-4 h-4 transition-transform" :class="{ 'rotate-90': showInactive }" fill="none" stroke="currentColor" viewBox="0 0 24 24">
              <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"/>
            </svg>
            <span x-text="showInactive ? 'Hide' : 'Show'"></span> Paused Charges ({{ inactiveCharges.length }})
          </button>

          <div x-show="showInactive" x-transition class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-4" style="display:none;">
            @each(charge in inactiveCharges)
              <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-5 opacity-60">
                <div class="flex justify-between items-start mb-3">
                  <div>
                    <h3 class="font-bold text-lg">{{ charge.name }}</h3>
                    <span class="text-xs text-gray-500 capitalize">{{ charge.frequency }}</span>
                  </div>
