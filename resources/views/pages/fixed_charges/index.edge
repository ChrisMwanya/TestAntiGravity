          <h3 class="text-4xl font-bold mt-2 text-yellow-400">${{ yearlyTotal.toFixed(2) }}</h3>
          <p class="text-xs text-gray-500 mt-1">Basé sur les charges actives</p>
        </div>
      </div>

      <!-- Active Charges -->
      <div class="space-y-4">
        <h2 class="text-2xl font-bold">Charges actives</h2>

        @if(activeCharges.length === 0)
          <div class="text-center py-12 text-gray-400 bg-white/5 rounded-2xl border border-white/10 border-dashed">
