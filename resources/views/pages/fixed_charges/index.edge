      </div>

      <!-- Add Form -->
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">
        <h2 class="text-xl font-bold mb-4">Add New Fixed Charge</h2>
        <form action="/fixed-charges" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {{ csrfField() }}

          <!-- Name -->
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">Name</label>
            <input
              type="text"
              name="name"
              required
              placeholder="e.g., Rent, Netflix, Electricity"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition"
            />
          </div>

          <!-- Amount -->
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">Amount</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">$</span>
              <input
                type="number"
                name="amount"
                step="0.01"
                min="0.01"
                required
                placeholder="0.00"
                class="w-full pl-8 pr-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition"
              />
            </div>
          </div>

          <!-- Frequency -->
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">Frequency</label>
            <select
              name="frequency"
              required
