@layout.app({ title: 'Ajouter une charge fixe' })

  @slot('main')
    <div class="max-w-3xl mx-auto space-y-6">

      {{-- Back link --}}
      <a
        href="/fixed-charges"
        class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-white transition"
      >
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"/>
        </svg>
        Retour aux charges fixes
      </a>

      {{-- Header --}}
      <div>
        <h1 class="text-2xl sm:text-4xl font-bold bg-gradient-to-r from-orange-400 to-yellow-400 bg-clip-text text-transparent">
          Ajouter une charge fixe
        </h1>
        <p class="text-gray-400 mt-2">Ajoutez une nouvelle facture récurrente ou un abonnement</p>
      </div>

      {{-- Flash error --}}
      @if(flashMessages.has('error'))
        <div class="bg-red-500/20 border border-red-500/50 rounded-xl p-4">
          <p class="text-red-400">{{ flashMessages.get('error') }}</p>
        </div>
      @endif

      {{-- Form --}}
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">
        <form action="/fixed-charges" method="POST" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
          {{ csrfField() }}

          {{-- Name --}}
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">Nom</label>
            <input
              type="text"
              name="name"
              required
              placeholder="ex. Loyer, Netflix, Électricité"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition"
            />
          </div>

          {{-- Amount --}}
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">Montant</label>
            <div class="relative">
              <span class="absolute left-4 top-1/2 -translate-y-1/2 text-gray-400">$</span>
              <input
                type="number"
                name="amount"
                step="0.01"
                min="0.01"
                required
                placeholder="0.00"
                class="w-full pl-8 pr-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition"
              />
            </div>
          </div>

          {{-- Frequency --}}
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">Fréquence</label>
            <select
              name="frequency"
              required
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none [&>option]:bg-slate-900 [&>option]:text-white"
            >
              <option value="daily">📅 Quotidien</option>
              <option value="weekly">📅 Hebdomadaire</option>
              <option value="monthly" selected>📅 Mensuel</option>
              <option value="quarterly">📅 Trimestriel</option>
              <option value="yearly">📅 Annuel</option>
            </select>
          </div>

          {{-- Billing Day --}}
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">
              Jour de facturation <span class="text-gray-500">(jour du mois, optionnel)</span>
            </label>
            <input
              type="number"
              name="billingDay"
              min="1"
              max="31"
              placeholder="ex. 1, 15, 28"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition"
            />
          </div>

          {{-- Start Date --}}
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">Date de début</label>
            <input
              type="date"
              name="startDate"
              required
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition text-white"
            />
          </div>

          {{-- End Date --}}
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">
              Date de fin <span class="text-gray-500">(optionnel)</span>
            </label>
            <input
              type="date"
              name="endDate"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition text-white"
            />
          </div>

          {{-- Category --}}
          <div>
            <label class="block text-sm font-medium mb-2 text-gray-300">
              Catégorie <span class="text-gray-500">(optionnel)</span>
            </label>
            <select
              name="categoryId"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none [&>option]:bg-slate-900 [&>option]:text-white"
            >
              <option value="">— Aucune —</option>
              @each(cat in categories)
                <option value="{{ cat.id }}">{{ cat.name }}</option>
              @endeach
            </select>
          </div>

          {{-- Notes --}}
          <div class="sm:col-span-2">
            <label class="block text-sm font-medium mb-2 text-gray-300">
              Notes <span class="text-gray-500">(optionnel)</span>
            </label>
            <input
              type="text"
              name="notes"
              placeholder="Détails supplémentaires..."
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-orange-500 outline-none transition"
            />
          </div>

          {{-- Actions --}}
          <div class="sm:col-span-2 lg:col-span-3 flex items-center gap-4">
            <button
              type="submit"
              class="px-8 py-3 bg-gradient-to-r from-orange-500 to-yellow-500 rounded-xl hover:from-orange-600 hover:to-yellow-600 transition font-semibold shadow-lg"
            >
              Ajouter la charge fixe
            </button>
            <a
              href="/fixed-charges"
              class="px-8 py-3 bg-white/10 border border-white/20 rounded-xl hover:bg-white/20 transition font-semibold"
            >
              Annuler
            </a>
          </div>
        </form>
      </div>

    </div>
  @endslot

@end
