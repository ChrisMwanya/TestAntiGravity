@layout.app({ title: 'Account Types' })

  @slot('main')
    <div class="space-y-6">
      <!-- Header -->
      <div>
        <h1
          class="text-4xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          Account Types
        </h1>
        <p class="text-gray-400 mt-2">
          Manage your custom account types
        </p>
      </div>

      <!-- Create Type Form -->
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">
        <h2 class="text-xl font-bold mb-4">
          Create New Type
        </h2>
        <form action="/account-types" method="POST" class="flex gap-4">
          {{ csrfField() }}
        <input
            type="text"
            name="name"
            required
            placeholder="Type name (e.g., Mobile Money)"
            class="flex-1 px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl hover:from-purple-600 hover:to-pink-600 transition font-medium"
          >
            Add Type
        </button>
        </form>
      </div>

      <!-- Types List -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @each(type in types)
          <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">

            {{-- Display mode --}}
            <div id="view-{{ type.id }}" class="flex justify-between items-center gap-2">
              <h3 class="text-xl font-bold truncate">{{ type.name }}</h3>
              @if(type.userId)
                <div class="flex items-center gap-2 shrink-0">
                  {{-- Edit button --}}
                  <button
                    type="button"
                    onclick="toggleEdit({{ type.id }})"
                    class="text-gray-400 hover:text-purple-400 transition"
                    title="Rename"
                  >
                    <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M15.232 5.232l3.536 3.536M9 11l6.536-6.536a2 2 0 012.828 2.828L11.828 13.828A2 2 0 0110 14.414V17h2.586a2 2 0 001.414-.586l6.536-6.536"/>
                    </svg>
                  </button>
                  {{-- Delete button --}}
                  <form action="/account-types/{{ type.id }}?_method=DELETE" method="POST">
                    {{ csrfField() }}
                    <button
                      type="submit"
                      class="text-red-400 hover:text-red-300 transition"
                      onclick="return confirm('Delete this account type?')"
                      title="Delete"
                    >
                      <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
                      </svg>
                    </button>
                  </form>
                </div>
              @else
                <span class="text-xs bg-white/10 px-2 py-1 rounded text-gray-400 shrink-0">System Default</span>
              @endif
            </div>

            {{-- Edit mode (hidden by default, only for custom types) --}}
            @if(type.userId)
              <div id="edit-{{ type.id }}" class="hidden">
                <form action="/account-types/{{ type.id }}?_method=PUT" method="POST" class="flex flex-col gap-3">
                  {{ csrfField() }}
                  <input
                    type="text"
                    name="name"
                    value="{{ type.name }}"
                    required
                    class="w-full px-4 py-2 bg-white/10 border border-purple-500/50 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none transition text-white"
                  />
                  <div class="flex gap-2">
                    <button
                      type="submit"
                      class="flex-1 px-4 py-2 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl hover:from-purple-600 hover:to-pink-600 transition font-medium text-sm"
                    >
                      Save
                    </button>
                    <button
                      type="button"
                      onclick="toggleEdit({{ type.id }})"
                      class="flex-1 px-4 py-2 bg-white/10 rounded-xl hover:bg-white/20 transition font-medium text-sm"
                    >
                      Cancel
                    </button>
                  </div>
                </form>
              </div>
            @endif

          </div>
        @else
          <div class="col-span-full text-center py-12 text-gray-400">
            No account types found.
          </div>
        @endeach
      </div>

      <script>
        function toggleEdit(id) {
          const view = document.getElementById('view-' + id)
          const edit = document.getElementById('edit-' + id)
          view.classList.toggle('hidden')
          edit.classList.toggle('hidden')
        }
      </script>
    </div>
  @endslot
  
@end
