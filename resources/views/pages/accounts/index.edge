@layout.app({ title: 'Accounts' })

  @slot('main')
    <div class="space-y-6">
      <!-- Header -->
      <div>
        <h1
          class="text-2xl sm:text-4xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          Accounts
        </h1>
        <p class="text-gray-400 mt-2">
          Manage your financial accounts
        </p>
      </div>

      <!-- Flash Messages -->
      @if(flashMessages.has('success'))
        <div class="bg-green-500/20 border border-green-500/50 rounded-xl p-4">
          <p class="text-green-400">{{ flashMessages.get('success') }}</p>
        </div>
      @endif

      <!-- Add Account Form -->
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">
        <h2 class="text-xl font-bold mb-4">
          Add New Account
        </h2>
        <form action="/accounts" method="POST" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-4 gap-4">
          {{ csrfField() }}
        <input
            type="text"
            name="name"
            required
            placeholder="Account name"
            class="px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none"
          />
          <select
            name="accountTypeId"
            required
            class="px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none [&>option]:bg-slate-900 [&>option]:text-white"
          >
            <option value="">
              Select type
            </option>
            @each(type in accountTypes)
              <option value="{{ type.id }}">
                {{ type.name }}
              </option>
            @endeach
          </select>
          <input
            type="number"
            name="balance"
            step="0.01"
            required
            placeholder="Initial balance"
            class="px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none"
          />
          <button
            type="submit"
            class="px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl hover:from-purple-600 hover:to-pink-600 transition font-medium"
          >
            Add Account
        </button>
        </form>
      </div>

      <!-- Accounts List -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @each(account in accounts)
          <div
            class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6 hover:border-white/20 transition-all"
          >
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold">
                  {{ account.name }}
                </h3>
                <p class="text-sm text-gray-400 capitalize">
                  {{ account.accountType.name }}
                </p>
              </div>
              <!-- Edit & Delete actions -->
              <div class="flex items-center space-x-2">
                <a
                  href="/accounts/{{ account.id }}/edit"
                  class="p-2 text-blue-400 hover:text-blue-300 hover:bg-blue-500/10 rounded-lg transition"
                  title="Edit account"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"
                    />
                  </svg>
                </a>
                <form action="/accounts/{{ account.id }}?_method=DELETE" method="POST" class="inline">
                  {{ csrfField() }}
                <button
                    type="submit"
                    class="p-2 text-red-400 hover:text-red-300 hover:bg-red-500/10 rounded-lg transition"
                    title="Delete account"
                    onclick="return confirm('Delete this account? All transactions will be deleted.')"
                  >
                    <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        stroke-width="2"
                        d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                      />
                    </svg>
                  </button>
                </form>
              </div>
            </div>

            <div class="pt-4 border-t border-white/10">
              <p class="text-gray-400 text-sm mb-1">
                Current Balance
              </p>
              <p class="text-3xl font-bold {{ account.balance >= 0 ? 'text-green-400' : 'text-red-400' }}">
                ${{ account.balance }}
              </p>
            </div>
          </div>
        @else
          <div class="col-span-full text-center py-12 text-gray-400">
            No accounts yet. Add your first account above!
          </div>
        @endeach
      </div>
    </div>
  @endslot
  
@end
