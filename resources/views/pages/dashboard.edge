      <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
        <!-- Recent Transactions -->
        <div class="lg:col-span-2 bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">
          <div class="flex justify-between items-center mb-6">
            <h2 class="text-2xl font-bold">
              Recent Transactions
            </h2>
            <a href="/transactions" class="text-purple-400 hover:text-purple-300 transition">View All →</a>
          </div>
          <div class="space-y-4">
            @each(transaction in recentTransactions)
              <div class="flex items-center justify-between p-4 bg-white/5 rounded-xl hover:bg-white/10 transition">
                <div class="flex items-center space-x-4">
                  <div
                    class="w-10 h-10 rounded-full flex items-center justify-center {{ transaction.type === 'income' ? 'bg-green-500/20' : 'bg-red-500/20' }}"
                  >
                    @if(transaction.type === 'income')
                      <span class="text-green-400">↑</span>
                    @else
                      <span class="text-red-400">↓</span>
                    @endif
                  </div>
                  <div>
                    <p class="font-medium">
                      {{ transaction.category?.name || 'Uncategorized' }}
                    </p>
                    <p class="text-sm text-gray-400">
                      {{ transaction.account.name }} • {{ transaction.date.toFormat('MMM dd, yyyy') }}
                    </p>
                  </div>
                </div>
                <div class="text-right">
                  <p class="font-bold {{ transaction.type === 'income' ? 'text-green-400' : 'text-red-400' }}">
                    {{ transaction.type === 'income' ? '+' : '-' }}${{ transaction.amount }}
                  </p>
