            <a href="/accounts" class="text-purple-400 hover:text-purple-300 transition">Manage →</a>
          </div>
          <div class="space-y-4">
            @each(account in accounts)
              <div class="p-4 bg-white/5 rounded-xl">
                <div class="flex justify-between items-center">
                  <div>
                    <p class="font-medium">
