{{-- Debt Card Partial --}}
<div class="bg-white/5 backdrop-blur-md border {{ debt.type === 'borrowed' ? 'border-red-500/20' : 'border-green-500/20' }} rounded-2xl p-5">
  <!-- Header -->
  <div class="flex justify-between items-start mb-3">
    <div>
      <h3 class="font-bold text-lg">{{ debt.name }}</h3>
      @if(debt.dueDate)
        <p class="text-xs text-gray-400 mt-0.5">
          Due: <span class="{{ new Date(debt.dueDate) < new Date() ? 'text-red-400' : 'text-gray-300' }}">{{ debt.dueDate }}</span>
        </p>
      @endif
    </div>
    <form action="/debts/{{ debt.id }}?_method=DELETE" method="POST">
      {{ csrfField() }}
      <button type="submit" onclick="return confirm('Delete this debt?')" class="text-red-400 hover:text-red-300 transition p-1 hover:bg-red-500/10 rounded-lg">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/>
        </svg>
      </button>
    </form>
  </div>

  @if(debt.notes)
    <p class="text-xs text-gray-500 mb-3 italic">{{ debt.notes }}</p>
  @endif

  <!-- Amounts -->
  <div class="space-y-1 mb-3">
    <div class="flex justify-between text-sm">
      <span class="text-gray-400">Original</span>
      <span>${{ Number(debt.amount).toFixed(2) }}</span>
    </div>
    <div class="flex justify-between text-sm">
      <span class="text-gray-400">Remaining</span>
      <span class="font-bold {{ debt.type === 'borrowed' ? 'text-red-400' : 'text-green-400' }}">${{ Number(debt.remainingAmount).toFixed(2) }}</span>
    </div>
  </div>

  <!-- Progress Bar -->
  @set('paidPercent', Math.round(((Number(debt.amount) - Number(debt.remainingAmount)) / Number(debt.amount)) * 100))
  <div class="mb-4">
    <div class="flex justify-between text-xs text-gray-500 mb-1">
      <span>{{ paidPercent }}% paid</span>
      <span>${{ (Number(debt.amount) - Number(debt.remainingAmount)).toFixed(2) }} paid</span>
    </div>
    <div class="w-full bg-white/10 rounded-full h-2">
      <div
        class="rounded-full h-2 transition-all {{ debt.type === 'borrowed' ? 'bg-gradient-to-r from-red-500 to-orange-500' : 'bg-gradient-to-r from-green-500 to-emerald-500' }}"
        style="width: {{ paidPercent }}%"
      ></div>
    </div>
  </div>

  <!-- Payment Form -->
  <form action="/debts/{{ debt.id }}/pay?_method=PUT" method="POST" class="flex gap-2">
    {{ csrfField() }}
    <div class="relative flex-1">
      <span class="absolute left-3 top-1/2 -translate-y-1/2 text-gray-400 text-sm">$</span>
      <input
        type="number"
        name="paymentAmount"
        step="0.01"
        min="0.01"
        max="{{ debt.remainingAmount }}"
        placeholder="Payment"
        required
        class="w-full pl-7 pr-3 py-2 bg-white/10 border border-white/20 rounded-xl text-sm focus:ring-2 focus:ring-purple-500 outline-none"
      />
    </div>
    <button
      type="submit"
      class="px-4 py-2 {{ debt.type === 'borrowed' ? 'bg-red-500/20 hover:bg-red-500/30 text-red-300' : 'bg-green-500/20 hover:bg-green-500/30 text-green-300' }} rounded-xl text-sm transition font-medium whitespace-nowrap"
    >
      Pay
    </button>
  </form>
</div>
