@layout.app({ title: 'Create Transaction' })

  @slot('main')
    <div class="max-w-2xl mx-auto">
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-8">
        <h1 class="text-3xl font-bold mb-6">
          New Transaction
        </h1>

        <form action="/transactions" method="POST" class="space-y-6">
          {{ csrfField() }}
          <div>
            <label class="block text-sm font-medium mb-2">Account</label>
            <select
              name="accountId"
              required
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none [&>option]:bg-slate-900 [&>option]:text-white"
            >
              <option value="">
                Select account
              </option>
              @each(account in accounts)
                <option value="{{ account.id }}">
                  {{ account.name }} ({{ account.accountType.name }})
                </option>
              @endeach
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium mb-2">Category</label>
            <select
              name="categoryId"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none [&>option]:bg-slate-900 [&>option]:text-white"
            >
              <option value="">
                Select category (optional)
              </option>
              @each(category in categories)
                <option value="{{ category.id }}">
                  {{ category.name }} ({{ category.type }})
                </option>
              @endeach
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium mb-2">Type</label>
            <select
              name="type"
              required
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none [&>option]:bg-slate-900 [&>option]:text-white"
            >
              <option value="income">
                Income
              </option>
              <option value="expense">
                Expense
              </option>
            </select>
          </div>

          <div>
            <label class="block text-sm font-medium mb-2">Amount</label>
            <input
              type="number"
              name="amount"
              step="0.01"
              required
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none"
              placeholder="0.00"
            />
          </div>

          <div>
            <label class="block text-sm font-medium mb-2">Date</label>
            <input
              type="date"
              name="date"
              required
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none"
            />
          </div>

          <div>
            <label class="block text-sm font-medium mb-2">Description</label>
            <textarea
              name="description"
              rows="3"
              class="w-full px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 focus:border-transparent outline-none"
              placeholder="Optional description"
            ></textarea>
          </div>

          <div class="flex space-x-4">
            <button
              type="submit"
              class="flex-1 px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl hover:from-purple-600 hover:to-pink-600 transition font-medium"
            >
              Create Transaction
          </button>
            <a
              href="/transactions"
              class="flex-1 px-6 py-3 bg-white/10 rounded-xl hover:bg-white/20 transition font-medium text-center"
            >
              Cancel
          </a>
          </div>
        </form>
      </div>
    </div>
  @endslot
  
@end
