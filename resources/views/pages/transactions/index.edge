@layout.app({ title: 'Transactions' })

  @slot('main')
    <div class="space-y-6">
      <!-- Header -->
      <div class="flex justify-between items-center">
        <h1
          class="text-4xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          Transactions
        </h1>
        <a
          href="/transactions/create"
          class="px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl hover:from-purple-600 hover:to-pink-600 transition font-medium"
        >
          + New Transaction
      </a>
      </div>

      <!-- Transactions List -->
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-white/5">
              <tr>
                <th class="px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Date
                </th>
                <th class="px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Description
                </th>
                <th class="px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Category
                </th>
                <th class="px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Account
                </th>
                <th class="px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Amount
                </th>
                <th class="px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              @each(transaction in transactions)
                <tr class="hover:bg-white/5 transition">
                  <td class="px-6 py-4 text-sm">
                    {{ transaction.date.toFormat('MMM dd, yyyy') }}
                  </td>
                  <td class="px-6 py-4">
                    <p class="font-medium">
                      {{ transaction.description || 'No description' }}
                    </p>
                  </td>
                  <td class="px-6 py-4 text-sm">
                    {{ transaction.category?.name || 'Uncategorized' }}
                  </td>
                  <td class="px-6 py-4 text-sm">
                    {{ transaction.account.name }}
                  </td>
                  <td class="px-6 py-4">
                    <span class="font-bold {{ transaction.type === 'income' ? 'text-green-400' : 'text-red-400' }}">
                      {{ transaction.type === 'income' ? '+' : '-' }}${{ transaction.amount }}
                  </span>
                  </td>
                  <td class="px-6 py-4">
                    <div class="flex space-x-2">
                      <a
                        href="/transactions/{{ transaction.id }}/edit"
                        class="px-3 py-1 bg-blue-500/20 hover:bg-blue-500/30 rounded-lg text-sm transition"
                      >
                        Edit
                    </a>
                      <form action="/transactions/{{ transaction.id }}?_method=DELETE" method="POST" class="inline">
                        {{ csrfField() }}
                      <button
                          type="submit"
                          class="px-3 py-1 bg-red-500/20 hover:bg-red-500/30 rounded-lg text-sm transition"
                          onclick="return confirm('Are you sure?')"
                        >
                          Delete
                      </button>
                      </form>
                    </div>
                  </td>
                </tr>
              @else
                <tr>
                  <td colspan="6" class="px-6 py-12 text-center text-gray-400">
                    No transactions yet. Create your first transaction!
                  </td>
                </tr>
              @endeach
            </tbody>
          </table>
        </div>
      </div>
    </div>
  @endslot
  
@end
