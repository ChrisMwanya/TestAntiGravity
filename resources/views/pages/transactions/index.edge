@layout.app({ title: 'Transactions' })

  @slot('main')
    <div class="space-y-6">
      <!-- Header -->
      <div class="flex flex-col sm:flex-row sm:justify-between sm:items-center gap-4">
        <h1
          class="text-2xl sm:text-4xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          Transactions
        </h1>
        <a
          href="/transactions/create"
          class="px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl hover:from-purple-600 hover:to-pink-600 transition font-medium text-center w-full sm:w-auto"
        >
          + Nouvelle transaction
      </a>
      </div>

      <!-- Transactions List -->
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden">
        <div class="overflow-x-auto">
          <table class="w-full">
            <thead class="bg-white/5">
              <tr>
                <th class="px-4 sm:px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Date
                </th>
                <th class="px-4 sm:px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Description
                </th>
                <th class="hidden sm:table-cell px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Catégorie
                </th>
                <th class="hidden md:table-cell px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Compte
                </th>
                <th class="px-4 sm:px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Montant
                </th>
                <th class="px-4 sm:px-6 py-4 text-left text-sm font-medium text-gray-400">
                  Actions
                </th>
              </tr>
            </thead>
            <tbody class="divide-y divide-white/10">
              @each(transaction in transactions)
                <tr class="hover:bg-white/5 transition">
                  <td class="px-4 sm:px-6 py-4 text-sm whitespace-nowrap">
                    {{ transaction.date.toFormat('MMM dd, yyyy') }}
                  </td>
                  <td class="px-4 sm:px-6 py-4">
                    <p class="font-medium truncate max-w-[120px] sm:max-w-xs">
                      {{ transaction.description || 'Sans description' }}
                    </p>
                  </td>
                  <td class="hidden sm:table-cell px-6 py-4 text-sm">
                    {{ transaction.category?.name || 'Sans catégorie' }}
                  </td>
                  <td class="hidden md:table-cell px-6 py-4 text-sm">
                    {{ transaction.account.name }}
                  </td>
                  <td class="px-4 sm:px-6 py-4">
                    <span class="font-bold text-sm sm:text-base {{ transaction.type === 'income' ? 'text-green-400' : 'text-red-400' }}">
                      {{ transaction.type === 'income' ? '+' : '-' }}${{ transaction.amount }}
                  </span>
                  </td>
                  <td class="px-4 sm:px-6 py-4">
                    <div class="flex space-x-2">
                      <a
                        href="/transactions/{{ transaction.id }}/edit"
                        class="px-3 py-1 bg-blue-500/20 hover:bg-blue-500/30 rounded-lg text-sm transition"
                      >
                        Modifier
                    </a>
                      <form action="/transactions/{{ transaction.id }}?_method=DELETE" method="POST" class="inline">
                        {{ csrfField() }}
                      <button
                          type="submit"
                          class="px-3 py-1 bg-red-500/20 hover:bg-red-500/30 rounded-lg text-sm transition"
                          onclick="return confirm('Êtes-vous sûr ?')"
                        >
                          Supprimer
                      </button>
                      </form>
                    </div>
                  </td>
                </tr>
              @else
                <tr>
                  <td colspan="6" class="px-6 py-12 text-center text-gray-400">
                    Aucune transaction pour le moment. <a href="/transactions/create" class="text-purple-400 underline">Créez votre première transaction !</a>
                  </td>
                </tr>
              @endeach
            </tbody>
          </table>
        </div>
      </div>
    </div>
  @endslot
  
@end
