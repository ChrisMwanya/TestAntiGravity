            Catégories de revenus
          </h3>
          <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl overflow-hidden">
            @each(category in categories.filter(c => c.type === 'income'))
              <div
                class="p-4 border-b border-white/10 last:border-0 flex justify-between items-center hover:bg-white/5 transition"
              >
                <div class="flex items-center space-x-3">
                  <div class="w-2 h-2 rounded-full {{ category.userId ? 'bg-purple-400' : 'bg-slate-400' }}">
                  </div>
                  <span class="font-medium">{{ category.name }}</span>
                  @if(!category.userId)
                    <span class="text-xs bg-white/10 px-2 py-1 rounded-full text-slate-400">System</span>
                  @endif
                </div>

                @if(category.userId)
                  <form
                    action="{{ route('categories.destroy', { id: category.id }) }}?_method=DELETE"
                    method="POST"
                    onsubmit="return confirm('Are you sure? This cannot be undone.')"
                  >
                    {{ csrfField() }}
                  <button
                      type="submit"
                      class="text-red-400 hover:text-red-300 transition p-2 hover:bg-red-400/10 rounded-lg"
