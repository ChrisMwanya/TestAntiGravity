@layout.app({ title: 'Budgets' })

  @slot('main')
    <div class="space-y-6">
      <!-- Header -->
      <div>
        <h1
          class="text-4xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent"
        >
          Budget Management
        </h1>
        <p class="text-gray-400 mt-2">
          Track your spending against your budget goals
        </p>
      </div>

      <!-- Create Budget Form -->
      <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">
        <h2 class="text-xl font-bold mb-4">
          Create New Budget
        </h2>
        <form action="/budgets" method="POST" class="grid grid-cols-1 md:grid-cols-4 gap-4">
          {{ csrfField() }}
        <select
            name="categoryId"
            required
            class="px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none [&>option]:bg-slate-900 [&>option]:text-white"
          >
            <option value="">
              Select category
            </option>
            @each(category in categories)
              <option value="{{ category.id }}">
                {{ category.name }}
              </option>
            @endeach
          </select>
          <input
            type="number"
            name="amount"
            step="0.01"
            required
            placeholder="Budget amount"
            class="px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none"
          />
          <select
            name="period"
            class="px-4 py-3 bg-white/10 border border-white/20 rounded-xl focus:ring-2 focus:ring-purple-500 outline-none [&>option]:bg-slate-900 [&>option]:text-white"
          >
            <option value="monthly">
              Monthly
            </option>
            <option value="weekly">
              Weekly
            </option>
            <option value="yearly">
              Yearly
            </option>
          </select>
          <button
            type="submit"
            class="px-6 py-3 bg-gradient-to-r from-purple-500 to-pink-500 rounded-xl hover:from-purple-600 hover:to-pink-600 transition font-medium"
          >
            Add Budget
        </button>
        </form>
      </div>

      <!-- Budgets List -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
        @each(budget in budgets)
          <div class="bg-white/5 backdrop-blur-md border border-white/10 rounded-2xl p-6">
            <div class="flex justify-between items-start mb-4">
              <div>
                <h3 class="text-xl font-bold">
                  {{ budget.category.name }}
                </h3>
                <p class="text-sm text-gray-400 capitalize">
                  {{ budget.period }}
                </p>
              </div>
              <form action="/budgets/{{ budget.id }}?_method=DELETE" method="POST" class="inline">
                {{ csrfField() }}
              <button
                  type="submit"
                  class="text-red-400 hover:text-red-300"
                  onclick="return confirm('Delete this budget?')"
                >
                  <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                    <path
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      stroke-width="2"
                      d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"
                    />
                  </svg>
                </button>
              </form>
            </div>

            <div class="space-y-2">
              <div class="flex justify-between text-sm">
                <span class="text-gray-400">Spent</span>
                <span class="font-medium">${{ budget.spent.toFixed(2) }} / ${{ budget.amount }}</span>
              </div>
              <div class="w-full bg-white/10 rounded-full h-3 overflow-hidden">
                <div
                  class="h-full rounded-full transition-all {{ budget.percentage > 100 ? 'bg-red-500' : budget.percentage > 80 ? 'bg-yellow-500' : 'bg-green-500' }}"
                  style="width: {{ Math.min(budget.percentage, 100) }}%"
                >
                </div>
              </div>
              <div class="flex justify-between text-sm">
                <span
                  class="{{ budget.percentage > 100 ? 'text-red-400' : budget.percentage > 80 ? 'text-yellow-400' : 'text-green-400' }}"
                >
                  {{ budget.percentage.toFixed(1) }}% used
              </span>
                <span class="text-gray-400">${{ (budget.amount - budget.spent).toFixed(2) }} remaining</span>
              </div>
            </div>
          </div>
        @else
          <div class="col-span-full text-center py-12 text-gray-400">
            No budgets yet. Create your first budget above!
          </div>
        @endeach
      </div>
    </div>
  @endslot
  
@end
