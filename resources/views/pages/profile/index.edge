                  <button
                    type="submit"
                    class="w-full px-4 py-2 bg-gradient-to-r from-purple-500 to-pink-500 rounded-lg hover:from-purple-600 hover:to-pink-600 transition font-medium"
                  >
                    Upload Avatar
                </button>
                </div>
              </form>

              <!-- Delete Avatar -->
              @if(user.avatar)
                <form action="/profile/avatar?_method=DELETE" method="POST" class="w-full">
                  {{ csrfField() }}
                <button
                    type="submit"
                    class="w-full px-4 py-2 bg-red-500/20 hover:bg-red-500/30 rounded-lg transition text-sm"
                    onclick="return confirm('Delete your avatar?')"
                  >
                    Remove Avatar
                </button>
                </form>
