              <!-- Upload Form -->
              <form action="/profile/avatar" method="POST" enctype="multipart/form-data" class="w-full">
                {{ csrfField() }}
                <div class="space-y-3">
                  <label class="block">
                    <span class="sr-only">Choose avatar</span>
                    <input
                      type="file"
                      name="avatar"
                      accept="image/jpeg,image/png,image/gif"
                      class="block w-full text-sm text-gray-400
                      file:mr-4 file:py-2 file:px-4
                      file:rounded-lg file:border-0
                      file:text-sm file:font-medium
                      file:bg-purple-500/20 file:text-purple-400
                      hover:file:bg-purple-500/30 file:cursor-pointer
                      cursor-pointer"
                    />
