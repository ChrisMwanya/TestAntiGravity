<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title || 'Finance Manager' }}</title>
  <script src="https://cdn.tailwindcss.com"></script>
  @vite(['resources/js/app.js'])
</head>
<body class="bg-gradient-to-br from-slate-900 via-purple-900 to-slate-900 min-h-screen text-white">
  <!-- Navigation -->
  <nav class="bg-white/10 backdrop-blur-md border-b border-white/10">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between h-16">
        <div class="flex items-center space-x-8">
          <a href="/dashboard" class="text-2xl font-bold bg-gradient-to-r from-purple-400 to-pink-400 bg-clip-text text-transparent">
            FinanceApp
          </a>
          <div class="hidden md:flex space-x-4">
            <a href="/dashboard" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Dashboard</a>
            <a href="/transactions" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Transactions</a>
            <a href="/budgets" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Budgets</a>
            <a href="/investments" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Investments</a>
            <a href="/accounts" class="px-3 py-2 rounded-lg hover:bg-white/10 transition">Accounts</a>
          </div>
        </div>
        <div class="flex items-center">
          <form action="/logout" method="POST">
            {{ csrfField() }}
            <button type="submit" class="px-4 py-2 bg-red-500/20 hover:bg-red-500/30 rounded-lg transition">
              Logout
            </button>
          </form>
        </div>
      </div>
    </div>
  </nav>

  <!-- Main Content -->
  <main class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8">
    {{{ await $slots.main() }}}
  </main>
</body>
</html>
